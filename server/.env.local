#PORT=5000

# PayHere — add your real credentials below
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_SANDBOX=true
# In production set this to your deployed server URL, e.g. https://api.lerd.lk/api/orders/notify
PAYHERE_NOTIFY_URL=http://localhost:5000/api/orders/notify

# Email — use a Gmail account with an App Password (not your normal password)
# To create an App Password: Google Account → Security → 2-Step Verification → App passwords
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=LERD <your-gmail@gmail.com>
